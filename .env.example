# ---------------------------------------------------------------------------
# eSewa (ePay v2)
#
# The values below are eSewa's PUBLIC test (RC) credentials - safe to commit
# and what you want for development and for a demo. For production, replace
# them with the merchant code and secret key eSewa issues you and set
# ESEWA_ENV=production. Never commit the live secret.
# ---------------------------------------------------------------------------
ESEWA_ENV=test
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# ---------------------------------------------------------------------------
# Khalti (ePayment v2)
#
# Public sandbox key for dev.khalti.com. For production, use your own live
# secret key and set KHALTI_ENV=production.
# ---------------------------------------------------------------------------
KHALTI_ENV=test
KHALTI_SECRET_KEY=live_secret_key_68791341fdd94846a146f0457ff7b455

# ---------------------------------------------------------------------------
# Admin
#
# Guards /admin. If ADMIN_PASSWORD is blank the admin refuses to load rather
# than sitting open. Change this before putting the site anywhere public.
# ---------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=shopnepal123

# Where the gateways send the customer back. Must be reachable from their
# browser - localhost will not work in production.
# ---------------------------------------------------------------------------
# Offline test gateway
#
# A local stand-in for eSewa/Khalti so checkout can be demonstrated with no
# internet. It marks orders paid without money moving, so it is refused
# outright when NODE_ENV=production. Set to false to hide it.
# ---------------------------------------------------------------------------
ENABLE_DUMMY_GATEWAY=true
DUMMY_GATEWAY_SECRET=change-me-in-production

PUBLIC_BASE_URL=http://localhost:3000

PORT=3000
